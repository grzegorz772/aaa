<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ObsidianLocalAI</AssemblyName>
    <RootNamespace>ObsidianLocalAI</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Obsidian Local AI</Company>
    <Product>Obsidian Local AI</Product>
    <Description>Fast, private, local AI note workspace with Ollama and WebLLM support</Description>
    
    <!-- Self-contained Single-File Executable without external resource compiler dependencies -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app_dist.zip" Condition="Exists('app_dist.zip')" />
    <EmbeddedResource Include="app_icon.png" Condition="Exists('app_icon.png')" />
  </ItemGroup>

</Project>
